# Copy this file to .env in the project root and adjust values as needed.
# Docker Compose automatically loads a root-level .env file.
#
# NOTE: MONGODB_URI and WEB3_PROVIDER_URI are NOT set here -- Docker Compose
# always points the backend at the mongodb/blockchain service names
# internally (see docker-compose.yml), so they are omitted intentionally.

# ---- MongoDB ----
MONGODB_DATABASE=finlend

# ---- Auth ----
JWT_SECRET_KEY=change_this_super_secret_key_for_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:4200
PORT=8000

# ---- Blockchain ----
# CONTRACT_ADDRESS is normally left blank -- the blockchain container
# deploys the contract automatically and the backend picks up its address
# at startup (see backend/docker-entrypoint.sh).
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK_NAME=hardhat-local
BLOCK_EXPLORER_BASE_URL=

# ---- Voice ----
# Defaults to the built-in deterministic demo engine (no external account
# needed). Set VOICE_PROVIDER and the relevant key(s) to use a real provider.
VOICE_PROVIDER=demo
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=

# ---- ML ----
MODEL_PATH=app/ml/artifacts/risk_model.joblib
