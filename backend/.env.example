# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=finlend

# ---- Auth ----
JWT_SECRET_KEY=change_this_super_secret_key_for_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:4200
PORT=8000

# ---- Blockchain (Hardhat local network by default) ----
WEB3_PROVIDER_URI=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK_NAME=hardhat-local
BLOCK_EXPLORER_BASE_URL=

# ---- Voice ----
# When no external provider credentials are supplied, the app automatically
# falls back to the local deterministic Demo STT/TTS engine implemented in
# app/services/voice_service.py. This keeps the primary user story runnable
# with zero external accounts.
VOICE_PROVIDER=demo
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=

# ---- ML ----
MODEL_PATH=app/ml/artifacts/risk_model.joblib
